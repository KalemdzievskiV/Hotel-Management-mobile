# Which backend the app talks to. Not a secret: it ends up inside the app bundle.
# Deployed backend on Railway (works from any network):
EXPO_PUBLIC_API_URL=https://hotel-management-backend-production-51c3.up.railway.app/api
# To use a backend running on this computer instead, put your LAN IP in .env.local:
#   EXPO_PUBLIC_API_URL=http://192.168.100.29:5001/api
